  "templates": [
    {
      "id": "%template.fourglcode.case",
      "name": "ON CASE - Template",
      "description": "The ON CASE statement is a multiple-way decision table.",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "on case ${variable}\ncase ${value_1}:\n\t${statement_1}\n\tbreak\ncase ${value_2}:\n\t${statement_2}\n\tbreak\ndefault:\n\t${statement_3}\n\tbreak\nendcase"
    },
    {
      "id": "%template.fourglcode.dllusage",
      "name": "DllUsage - Template",
      "description": "DllUsage is mandatory for external Infor LN functions, because it contains often processing, starting a session, or calculations.",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "DllUsage\nExpl:\t${text}\nPre:\t${preconditions}\nPost:\t${postconditions}\nInput:\t${input_arg}\nOutput:\t${output_arg}\nReturn:\t${returnType}\nEndDllUsage"
    },
    {
      "id": "%template.fourglcode.functionusage",
      "name": "FunctionUsage Template",
      "description": "FunctionUsage is mandatory for every function in Infor LN and beyond, only very simple functions are excluded.",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "FunctionUsage\nExpl:\t${text}\nPre:\t${preconditions}\nPost:\t${postconditions}\nInput:\t${input_arg}\nOutput:\t${output_arg}\nReturn:\t${returnType}\nEndFunctionUsage"
    },
    {
      "id": "%template.fourglcode.all.args",
      "name": "All Function Arguments Template",
      "description": "Inserts all arguments from the current function (comma separated).",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "${all_args_cs}"
    },
    {
      "id": "%template.fourglcode.for",
      "name": "For - Template",
      "description": "For Control Flow Statement",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "for ${num_var} = ${num_expr_1} to ${num_expr_2}\n\t${statement}\nendfor"
    },
    {
      "id": "%template.fourglcode.for.step",
      "name": "For Step - Template",
      "description": "For Step Control Flow Statement",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "for ${num_var} = ${num_expr_1} to ${num_expr_2} step ${num_expr_3}\n\t${statement}\nendfor"
    },
    {
      "id": "%template.fourglcode.repeat",
      "name": "Repeat - Template",
      "description": "Repeat Control Flow Statement",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "repeat\n\t${statement}\nuntil ${expression}"
    },
    {
      "id": "%template.fourglcode.while",
      "name": "While - Template",
      "description": "While Control Flow Statement",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "while ${expression}\n\t${statement}\nendwhile"
    },
    {
      "id": "%template.fourglcode.if",
      "name": "IF...THEN",
      "description": "This tests a condition. If the condition evaluates to TRUE, the statements following the IF...THEN statement are executed.",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "if ${condition} then\n\t${statement}\nendif"
    },
    {
      "id": "%template.fourglcode.if.then.else",
      "name": "IF...THEN...ELSE",
      "description": "This tests a condition. If the condition evaluates to TRUE, the statements following the IF...THEN statement are executed. If the condition evaluates to FALSE, the statements following the ELSE statement are executed.",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "if ${condition} then\n\t${statement1}\nelse\n\t${statement2}\nendif"
    },
    {
      "id": "%template.fourglcode.select",
      "name": "Select - Template",
      "description": "Select Statement",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "select\t${table}.*\nfrom\t${table}\nwhere\t${table}._index${cursor}\nselectdo\n\t|* todo: add operation(s) on all selected records\nselectempty\n\t|* todo: add operation(s) if nothing has been selected \nendselect"
    },
    {
      "id": "%template.fourglcode.comment.block",
      "name": "Comment Block - Template",
      "description": "Inserts a comment block on the current position",
      "context": "com.infor.ln.studio.apps.ui.template.fourglcode",
      "pattern": "${comment_block}"
    }
  ]
}